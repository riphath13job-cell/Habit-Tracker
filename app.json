{
  "expo": {
    "name": "Blueprint",
    "slug": "habit-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "habittracker",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.richa.habittracker",
      "infoPlist": {
        "CFBundleDisplayName": "Blueprint"
      }
    },
    "android": {
      "package": "com.richa.habittracker",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Blueprint uses your photo library to set book covers."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4338CA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1E1B4B"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.richa.habittracker",
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Blueprint",
              "description": "Today's habit progress and streak.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"]
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "83fc7deb-9fa3-472b-8df5-32e26f6a890d"
      }
    },
    "owner": "riphath13",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/83fc7deb-9fa3-472b-8df5-32e26f6a890d"
    }
  }
}
