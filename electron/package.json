{
  "name": "blueprint-desktop",
  "version": "1.0.0",
  "description": "Blueprint — your habit tracker for the desktop",
  "author": "r",
  "main": "main.js",
  "private": true,
  "build": {
    "appId": "com.richa.blueprint",
    "productName": "Blueprint",
    "electronVersion": "44.0.0",
    "asar": true,
    "files": [
      "main.js",
      "dist/**/*"
    ],
    "directories": {
      "buildResources": ".",
      "output": "./release"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Blueprint-Setup-${version}.${ext}"
    }
  }
}
